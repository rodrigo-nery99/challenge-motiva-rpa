# ---------------------------------------------------------------
# IA (OpenAI)
# ---------------------------------------------------------------
OPENAI_API_KEY=
# gpt-4.1-mini funciona sem verificação de organização na OpenAI.
# Para usar gpt-5-mini, a organização precisa estar verificada.
OPENAI_MODEL=
# Só para modelos da família GPT-5 (minimal, low, medium, high). Deixe vazio no gpt-4.1-mini.
OPENAI_REASONING_EFFORT=
# Abaixo desta confiança a solicitação vai para triagem humana
IA_CONFIANCA_MINIMA=0.6
# Se a OpenAI estiver indisponível (sem chave ou erro), usa o motor de regras
IA_PERMITIR_FALLBACK=true

# ---------------------------------------------------------------
# Gmail — captura (IMAP) e envio (SMTP)
# Conta Gmail pessoal criada para o grupo, com verificação em duas
# etapas ligada e uma "senha de app" (myaccount.google.com/apppasswords).
# ---------------------------------------------------------------
GMAIL_USUARIO=
GMAIL_SENHA_APP=
GMAIL_PASTA_ENTRADA=INBOX
# Marcador do Gmail onde os e-mails processados são copiados (criado automaticamente).
GMAIL_MARCADOR_PROCESSADOS=Motiva-RPA/Processados
GMAIL_MARCADOR_ERROS=Motiva-RPA/Erros
# Opcional: processa só e-mails cujo assunto contenha este texto
GMAIL_FILTRO_ASSUNTO=

# ---------------------------------------------------------------
# Encaminhamento
# ---------------------------------------------------------------
# arquivo -> grava os e-mails em saida/emails/ (demo sem envio real)
# smtp    -> envia de verdade pelo Gmail configurado acima
ENVIO_MODO=arquivo
# Se preenchido, TODOS os envios vão para este endereço (o destinatário
# original aparece no assunto). Útil porque a matriz usa endereços fictícios.
ENVIO_REDIRECIONAR_PARA=
ENVIAR_CONFIRMACAO_SOLICITANTE=true

# ---------------------------------------------------------------
# Pastas, banco e cadastro
# ---------------------------------------------------------------
PASTA_ENTRADA=entrada
PASTA_SAIDA=saida
BANCO_DADOS=dados/solicitacoes.db
CADASTRO_TRECHOS=dados/trechos_motiva.csv
MATRIZ_ROTEAMENTO=config/roteamento.yaml
MONITOR_INTERVALO_SEGUNDOS=60
